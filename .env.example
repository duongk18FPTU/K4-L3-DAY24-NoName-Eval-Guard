# Paste your OpenRouter API key here (the SDK uses this variable name).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LangChain / NeMo 0.10 reads OPENAI_API_BASE.
OPENAI_API_BASE=https://openrouter.ai/api/v1
JUDGE_MODEL=openrouter/free

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
